# FutbolClip AI — kopyalayın: cp .env.example .env  ve doldurun

# --- Video arama (YouTube Data API v3: Google Cloud Console → API'ler → anahtar) ---
YOUTUBE_API_KEY=

# --- Türkçe konuşma tanıma: birini seçin (hiçbiri yoksa SRT/VTT yükleyerek çalışır) ---
# Yerel: pip install faster-whisper   (TRANSCRIBE_PROVIDER=auto iken otomatik kullanılır)
WHISPER_MODEL=small
GROQ_API_KEY=
OPENAI_API_KEY=
TRANSCRIBE_PROVIDER=auto

# --- Başlık / viral puanı üretimi (isteğe bağlı; yoksa yerleşik sezgisel puanlama çalışır) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# --- Sunucu ---
HOST=127.0.0.1
PORT=8080
ALLOW_REGISTRATION=true
COOKIE_SECURE=false        # HTTPS arkasında true yapın
MAX_ANALYZE_MINUTES=45
MAX_UPLOAD_MB=2048
WORKERS=2
